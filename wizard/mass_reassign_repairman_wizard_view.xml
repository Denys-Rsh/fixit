<odoo>
    <record id="fixit_mass_reassign_repairman_wizard_form" model="ir.ui.view">
        <field name="name">fixit.mass.reassign.repairman.wizard.form</field>
        <field name="model">fixit.mass.reassign.repairman.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="order_ids" widget="many2many_tags" />
                    <field name="repairman_id" />
                </group>
                <footer>
                    <button name="action_reassign" type="object" string="Reassign" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="fixit_mass_reassign_repairman_wizard_action" model="ir.actions.act_window">
        <field name="name">Reassign Repairman</field>
        <field name="res_model">fixit.mass.reassign.repairman.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fixit_order" />
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_fixit_admin'))]"/>
    </record>
</odoo>