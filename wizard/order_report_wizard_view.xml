<odoo>
    <record id="fixit_order_report_wizard_form" model="ir.ui.view">
        <field name="name">fixit.order.report.wizard.form</field>
        <field name="model">fixit.order.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="order_ids" widget="many2many_tags" />
                        <field name="repairman_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>
                <footer>
                    <button name="action_show_report" type="object" string="Print" class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="fixit_order_report_wizard_order_action" model="ir.actions.act_window">
        <field name="name">Order Report</field>
        <field name="res_model">fixit.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fixit_order" />
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="fixit_order_report_wizard_repairman_action" model="ir.actions.act_window">
        <field name="name">Repairman Report</field>
        <field name="res_model">fixit.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
