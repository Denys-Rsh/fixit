<odoo>
    <record id="fixit_order_line_list_view" model="ir.ui.view">
        <field name="name">fixit.order.line.list</field>
        <field name="model">fixit.order.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="fixit_order_line_action" model="ir.actions.act_window">
        <field name="name">Order Line</field>
        <field name="res_model">fixit.order.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="fixit_order_line_action_menu"
              name="Order Lines"
              parent="fixit_order_main_menu"
              action="fixit_order_line_action"
              sequence="10"/>
</odoo>